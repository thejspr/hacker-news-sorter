{
  "manifest_version": 3,
  "name": "Hacker News Sorter",
  "version": "2.0.1",
  "description": "Sort posts by points, enables search and linkify's Hacker News.",
  "content_scripts": [
    {
    "matches": [
      "*://news.ycombinator.com/*"
    ],
    "js": ["content.js", "auto-link.js"]
  }
  ],
  "icons": {
    "48": "icon2.png"
  },
  "host_permissions": [
    "*://news.ycombinator.com/*"
  ]
}
